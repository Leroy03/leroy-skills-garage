{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://codex.local/schemas/test_result.schema.json",
  "title": "DevFlow Test Result",
  "type": "object",
  "required": [
    "schema_version",
    "project",
    "generated_at",
    "summary",
    "commands"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "project": {
      "type": "string",
      "minLength": 1
    },
    "run_id": {
      "type": "string"
    },
    "level": {
      "type": "string",
      "enum": [
        "L2",
        "L3"
      ]
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "environment": {
      "type": "object",
      "properties": {
        "os": {
          "type": "string"
        },
        "python": {
          "type": "string"
        },
        "venv_path": {
          "type": "string"
        },
        "cwd": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "summary": {
      "type": "object",
      "required": [
        "total_commands",
        "passed",
        "failed",
        "duration_ms",
        "overall_status"
      ],
      "properties": {
        "total_commands": {
          "type": "integer",
          "minimum": 0
        },
        "passed": {
          "type": "integer",
          "minimum": 0
        },
        "failed": {
          "type": "integer",
          "minimum": 0
        },
        "duration_ms": {
          "type": "integer",
          "minimum": 0
        },
        "overall_status": {
          "type": "string",
          "enum": [
            "passed",
            "failed"
          ]
        }
      },
      "additionalProperties": true
    },
    "commands": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "command",
          "status",
          "exit_code",
          "duration_ms"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "command": {
            "type": "string"
          },
          "start_at": {
            "type": "string",
            "format": "date-time"
          },
          "end_at": {
            "type": "string",
            "format": "date-time"
          },
          "duration_ms": {
            "type": "integer",
            "minimum": 0
          },
          "exit_code": {
            "type": "integer"
          },
          "status": {
            "type": "string",
            "enum": [
              "passed",
              "failed"
            ]
          },
          "stdout_snippet": {
            "type": "string"
          },
          "stderr_snippet": {
            "type": "string"
          },
          "artifacts": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": true
      }
    },
    "coverage": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "overall_percent": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "threshold_percent": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "status": {
          "type": "string",
          "enum": [
            "passed",
            "failed",
            "skipped"
          ]
        }
      },
      "additionalProperties": true
    },
    "quality_gates": {
      "type": "object",
      "properties": {
        "review_gate": {
          "type": "string",
          "enum": [
            "passed",
            "failed",
            "skipped"
          ]
        },
        "delivery_gate": {
          "type": "string",
          "enum": [
            "passed",
            "failed",
            "skipped"
          ]
        },
        "reasons": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
